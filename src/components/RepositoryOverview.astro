---
import { getUi, type Locale } from "@/i18n/index";

interface Props {
  lang: Locale;
  base: string;
}

const { lang } = Astro.props;
const t = getUi(lang);

interface Repo {
  code: string | null;
  label: string | null;
  url: string;
  en: string;
  de: string;
}

const repos: Repo[] = [
  {
    code: "VDA 231‑300",
    label: "Generic",
    url: "https://github.com/VDA231-301/VDA231-300",
    en: "Material and surface definition in 3D-models in JT",
    de: "Material- und Oberflächendefinition in 3D-Modellen im JT",
  },
  {
    code: "VDA 231‑301",
    label: "Generic",
    url: "https://github.com/VDA231-301/VDA231-301",
    en: "Generic core definitions and reusable model elements",
    de: "Generische Basismodelle und wiederverwendbare Strukturen",
  },
  {
    code: "VDA 275",
    label: "Formaldehyde",
    url: "https://github.com/VDA231-301/VDA_231-301__VDA_275",
    en: "Formaldehyde emission test data",
    de: "Formaldehyd‑Emissionsprüfungen",
  },
  {
    code: "VDA 278",
    label: "VOC / Fogging",
    url: "https://github.com/VDA231-301/VDA_231-301__VDA_278",
    en: "VOC and fogging emission test data",
    de: "VOC‑ und Fogging‑Emissionsdaten",
  },
  {
    code: "VDA 270",
    label: "Odor",
    url: "https://github.com/VDA231-301/VDA_231-301__VDA_270",
    en: "Odor assessment based on panel testing",
    de: "Geruchsprüfungen mit Panelbewertung",
  },
  {
    code: "SEP 1240",
    label: "Tensile testing",
    url: "https://github.com/VDA231-301/VDA_231-301__SEP_1240",
    en: "Experimental Determination of Mechanical Properties of Steel Sheets for CAE-Calculations",
    de: "Experimentelle Ermittlung mechanischer Kennwerte von Feinblechen aus Stahl für die CAE-Berechnung",
  },
  {
    code: "EN 10204",
    label: "3.1 Inspection Certificate",
    url: "https://github.com/VDA231-301/VDA_231-301__EN_10204",
    en: "Digital inspection and acceptance certificates",
    de: "Digitale Prüf‑ und Abnahmezeugnisse",
  },
  {
    code: null,
    label: "Substance Declaration",
    url: "https://github.com/VDA231-301/VDA_231-301__SubstanceDeclaration",
    en: "Structured substance and material composition data",
    de: "Strukturierte Stoff‑ und Materialzusammensetzungen",
  },
];

const githubSvg = `<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>`;
---

<section class="section">
  <div class="shell">
    <p class="section-lede mb-12">{t.catalog.repoOverviewLede}</p>

    <div class="rounded-[var(--radius-l)] border border-[var(--line)] bg-[var(--bg-tint)] p-8 md:p-10">
      <p class="eyebrow">{t.catalog.downloadsEyebrow}</p>
      <h2 class="display mt-2 mb-3 text-[26px] md:text-[30px]">{t.catalog.downloadsTitle}</h2>
      <p class="max-w-2xl text-[15px] leading-relaxed text-[var(--ink-3)]">
        {t.catalog.downloadsIntro}
      </p>

      <div class="mt-9">
        <h3 class="text-[17px] font-semibold text-[var(--ink)]">{t.catalog.downloadsHowTitle}</h3>

        <div class="mt-5 grid gap-10 md:grid-cols-[1.3fr_1fr]">
          <div>
            <p
              class="mb-4 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-[var(--ink-4)]">
              {t.catalog.downloadsViaReleases}
            </p>

            <div class="grid gap-3">
              {
                t.catalog.downloadsSteps.map((step, i) => (
                  <div class="modular-item">
                    <div class="marker">{String(i + 1).padStart(2, "0")}</div>
                    <p class="m-0 text-[14px] text-[var(--ink-2)]">{step}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="md:border-l md:border-[var(--line)] md:pl-10">
            <p
              class="mb-4 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-[var(--ink-4)]">
              {t.catalog.downloadsViaRepo}
            </p>

            <div class="flex flex-col gap-3">
              <a
                href={t.catalog.viewerLink}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-ghost w-full justify-between">
                {t.catalog.viewerTitle}
                <span aria-hidden="true">↗</span>
              </a>
              <a
                href={t.catalog.repoLink}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-ghost w-full justify-between"
                set:html={`${t.catalog.repoTitle} ${githubSvg}`}
              />
            </div>
          </div>
        </div>
      </div>

      <div class="mt-10 border-t border-[var(--line)] pt-8">
        <h3
          class="font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-[var(--ink-4)]">
          {t.catalog.bestPracticeTitle}
        </h3>
        <ul class="mt-4 grid gap-2.5 text-[14px] text-[var(--ink-2)] sm:grid-cols-2">
          {
            t.catalog.bestPractice.map((tip) => (
              <li class="flex items-start gap-2">
                <span class="mt-px text-[var(--brand)]" aria-hidden="true">
                  ✓
                </span>
                {tip}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="repo-table-wrap mt-16">
      <table class="repo-table">
        <thead>
          <tr>
            <th>{t.catalog.repoTableHeaderRepo}</th>
            <th>{t.catalog.repoTableHeaderFocus}</th>
          </tr>
        </thead>
        <tbody>
          {
            repos.map((repo) => (
              <tr>
                <td>
                  <a href={repo.url} target="_blank" rel="noopener noreferrer">
                    {repo.code && <span class="chip">{repo.code}</span>}
                    {repo.label && <span>{repo.label}</span>}
                    <span class="gh-icon" set:html={githubSvg} />
                  </a>
                </td>
                <td>{lang === "de" ? repo.de : repo.en}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-5 text-[13px] text-[var(--ink-3)]">{t.catalog.repoTableNote}</p>
  </div>
</section>

<style>
  .repo-table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-m);
    border: 1px solid var(--line);
  }
  .repo-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    text-align: left;
  }
  .repo-table thead tr {
    background: var(--bg-tint);
  }
  .repo-table th {
    padding: 12px 16px;
    font-weight: 600;
    font-size: 13px;
    color: var(--ink-2);
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  .repo-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    color: var(--ink-3);
  }
  .repo-table tbody tr {
    transition: background-color 0.15s;
  }
  .repo-table tbody tr:hover {
    background: var(--bg-tint);
  }
  .repo-table tbody tr:last-child td {
    border-bottom: none;
  }
  .repo-table td:first-child {
    white-space: nowrap;
  }
  .repo-table td a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .repo-table td a:hover {
    text-decoration: none;
  }
  .repo-table td a:hover .chip {
    background: var(--brand-soft);
    color: var(--brand-deep);
  }
  .repo-table .chip {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--brand-deep);
    transition: background-color 0.15s, color 0.15s;
  }
  .repo-table .gh-icon {
    display: inline-flex;
    color: var(--ink-4);
  }
</style>
